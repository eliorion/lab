# =====================================================================================
#  Bitbucket project migration - configuration
#  Copy this file to .env (same folder) and fill it in:   cp .env.example .env
#
#  Format: KEY=VALUE, one per line. The value is taken literally (no $ expansion),
#  so passwords with special characters work as-is. Wrap the value in single quotes
#  only if it contains " #" (space + hash) or starts/ends with spaces.
#  Never commit .env (it is in .gitignore).
# =====================================================================================

# -------------------------------------------------------------------------------------
#  SOURCE server - Bitbucket 7.21.10 (the one you are system admin on)
#  The scripts only READ from this server: nothing is ever created, modified or deleted
#  on it (enforced in the code). A read-only token makes it impossible even by mistake.
# -------------------------------------------------------------------------------------
# Base URL as seen in the browser, including the context path if any, no trailing slash.
#   e.g. https://bitbucket.company.com   or   https://git.company.com/bitbucket
SOURCE_URL=https://bitbucket-source.example.com
SOURCE_PROJECT_KEY=PROJ

# bearer = HTTP access token (recommended on 7.x). Create it in Bitbucket:
#   avatar > Manage account > HTTP access tokens > Create token
#   Permissions: Project READ + Repository READ is enough to migrate
#   (Repository ADMIN also lets the scripts read the per-repository "LFS enabled" flag).
# basic  = username + password
SOURCE_AUTH_TYPE=bearer
# Username: required for basic; with bearer it is only used to check the token owner.
SOURCE_USERNAME=
SOURCE_TOKEN=
SOURCE_PASSWORD=

# Expected version: a warning is shown if the server reports another one.
SOURCE_EXPECTED_VERSION=7.21.10
# Internal CA (PEM file) if the certificate is not trusted by this machine.
SOURCE_CA_BUNDLE=
# Last resort only: disables TLS certificate verification.
SOURCE_INSECURE_TLS=false

# -------------------------------------------------------------------------------------
#  TARGET server - Bitbucket 4.14.2 (you are PROJECT_ADMIN on the target project)
# -------------------------------------------------------------------------------------
TARGET_URL=https://bitbucket-target.example.com
# Key of the target project. Empty = same key as SOURCE_PROJECT_KEY.
# Set it only if the project key is different on the new server.
# The project must already exist (project admins cannot create projects).
TARGET_PROJECT_KEY=

# Bitbucket 4.14 has NO personal/HTTP access tokens (they arrived in 5.5):
# use basic = your username + password on that server (LDAP password if LDAP is used).
TARGET_AUTH_TYPE=basic
TARGET_USERNAME=
TARGET_PASSWORD=
TARGET_TOKEN=

TARGET_EXPECTED_VERSION=4.14.2
TARGET_CA_BUNDLE=
TARGET_INSECURE_TLS=false

# -------------------------------------------------------------------------------------
#  Migration behaviour
# -------------------------------------------------------------------------------------
# Everything the scripts create goes into OUTPUT_DIR (relative to this folder):
#   output/STATUS.txt   live status of the current run (scripts/watch-progress.sh shows it)
#   output/logs/        one folder per run: logs, reports, per-repository logs
#   output/state/       list of the repositories already migrated (used to resume)
#   output/work/        temporary local copies (each one is deleted after its migration)
OUTPUT_DIR=output
# Optional: put one of them elsewhere, e.g. the work copies on a bigger disk. The work
# folder must hold the biggest repository + all its LFS objects.
#WORK_DIR=/data/bitbucket-migration-work
#LOG_DIR=
#STATE_DIR=

# Repository already present on the target:
#   skip = leave it alone (an EMPTY existing repository is filled: resume after a crash)
#   sync = push again into it, updating the branches/tags that changed on the source since
#          the first migration (delta sync before the cut-over). Same as --sync.
#   fail = report it as an error
# Repositories are NEVER deleted, neither on the source nor on the target.
EXISTING_REPO_POLICY=skip
# With sync only: a branch/tag DELETED on the source after the first migration is also
# deleted in the TARGET copy (same as --prune). false = it stays on the target, and
# 04-verify-project.sh reports the repository as not identical. Never touches the source.
SYNC_PRUNE=false

# Git LFS
MIGRATE_LFS=true
# Enable LFS on the target repository: auto (if enabled on source or LFS objects found),
# always (every repository), never
TARGET_ENABLE_LFS=auto
# true = continue when some LFS objects are missing on the SOURCE server itself
LFS_ALLOW_MISSING=false
# Check through the LFS API that every object exists on the target after the upload
VERIFY_LFS=true
LFS_CONCURRENT_TRANSFERS=4

# Repository settings copied to the target
COPY_DEFAULT_BRANCH=true
COPY_FORKABLE=true
# Keep false unless you really want "public" (anonymous) repositories on the target
COPY_PUBLIC=false

# Comma separated list of slugs (shell patterns allowed) NOT to migrate, e.g. old-*,sandbox
REPO_EXCLUDE=

# Repository used by default by 02-test-single-repo.sh (choose one that uses Git LFS)
TEST_REPO_SLUG=
# Name suffix of the test copy created on the target
TEST_TARGET_SUFFIX=-migration-test

# Keep the local copies after migration: false | true | on-failure
# (true makes a later "sync" run much faster but needs disk space for ALL repositories)
KEEP_WORKDIR=false

# Robustness
RETRY_COUNT=2
MAX_CONSECUTIVE_FAILURES=5
MIN_FREE_SPACE_GB=20
CURL_CONNECT_TIMEOUT=15
CURL_TIMEOUT=120
PAGE_LIMIT=100
# Only if pushes of big repositories fail with "RPC failed; HTTP 413/411", e.g. 524288000
GIT_HTTP_POST_BUFFER=
