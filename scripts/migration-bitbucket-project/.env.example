# Copy this file to .env and fill it in:  cp .env.example .env && chmod 600 .env
# Keep the values between 'single quotes' (needed if they contain spaces, $, # ...).

# ---- Source server: Bitbucket 7.21.10 (only read, never modified) ------------------------
# URL as in the browser, with the context path if any (e.g. https://git.company.com/bitbucket)
SOURCE_URL='https://bitbucket-old.example.com'
SOURCE_PROJECT='PROJ'
# HTTP access token (avatar > Manage account > HTTP access tokens, "Read" permissions)...
SOURCE_TOKEN=''
# ...or your username and password instead of a token
SOURCE_USER=''
SOURCE_PASSWORD=''

# ---- Target server: Bitbucket 4.14.2 (no tokens on this version: username/password) ------
TARGET_URL='https://bitbucket-new.example.com'
# Empty = same project key as the source
TARGET_PROJECT=''
TARGET_USER=''
TARGET_PASSWORD=''

# Internet proxy, used ONLY by scripts/update.sh to download new versions from GitHub
# (the migration itself talks to the Bitbucket servers directly), e.g. 'http://proxy.company:8080'
PROXY=''

# Certificates (only if a check says "SSL certificate problem"):
# - on Windows (Git Bash): 'true' = trust the Windows certificate store (company certificates)
WINDOWS_CERT_STORE='false'
# - or: PEM file of your company certificate authority
CA_BUNDLE=''
